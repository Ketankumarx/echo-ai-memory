# ECHO AI Personal Memory Assistant — Environment Configuration

# Speech-to-Text (Groq Whisper or OpenAI Whisper)
GROQ_API_KEY=
OPENAI_API_KEY=

# LLM Providers (Gemini, OpenAI, or Groq)
GEMINI_API_KEY=

# Real-time Web Search Grounding (Google Search via SerpApi)
SERPAPI_API_KEY=

# Local Storage
DATABASE_PATH=echo_memory.db
AUDIO_UPLOAD_DIR=uploads/audio
