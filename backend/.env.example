# ECHO AI Memory Assistant - Environment Configuration

# Speech-to-Text (Recommended: Groq for sub-second Whisper transcription)
GROQ_API_KEY=

# LLM & Embeddings (Gemini or OpenAI)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Web Grounding (Google Search API)
SERPAPI_API_KEY=

# Local Storage
DATABASE_PATH=echo_memory.db
AUDIO_UPLOAD_DIR=uploads/audio
